# Downloaded pages and API responses. ~99MB, entirely regenerable, and
# rewritten on every run -- by far the biggest thing in this folder.
.cache/

# Regenerated on every run. The committed snapshots in tests/ are what the
# regression check compares against.
output/
run.log

__pycache__/
*.pyc

# Service-account keys, if the disabled gspread path is ever enabled. These are
# live credentials and must never be committed.
*.json.key
service_account*.json

# Kyle's actual league rosters. Kept out of the public repo deliberately -- and
# superseded anyway once rosters are read from the Google Sheet. Public git
# history is permanent, so this must stay excluded from the first push onward.
rosters/
