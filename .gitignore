# Downloaded pages and API responses. ~99MB, entirely regenerable. On Actions
# it is restored by actions/cache instead of living here.
.cache/

run.log
__pycache__/
*.pyc

# Live credentials. Must never be committed.
*.json.key
service_account*.json

# Kyle's actual league rosters. Kept out of the public repo deliberately -- and
# superseded anyway once rosters are read from the Google Sheet. Public git
# history is permanent, so this must stay excluded from the first push onward.
rosters/

# Outputs ARE published now -- Actions commits them so Apps Script can read
# them from raw.githubusercontent.com. Only the dated duplicates stay out:
# every run is already a commit, so git IS the history.
output/history/